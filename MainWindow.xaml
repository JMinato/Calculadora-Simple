<Window x:Class="Calculadora_Simple.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculadora_Simple"
        mc:Ignorable="d"
        Title="Calculadora" Height="480" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Background="#5D93E4" 
        HorizontalAlignment="Stretch" 
        VerticalAlignment="Center" 
        Padding="20"
                Margin="20" CornerRadius="20">

            <TextBlock Text="Calculadora Simple" 
               Foreground="White" 
               FontSize="36" 
               FontWeight="Bold"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,20"> 
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#4682B4" CornerRadius="10" Margin ="0,0,10,0" Padding="10">
                <Border.Effect> 
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>
                    
                    <Label Content="Número 1" FontSize="16" FontWeight="Bold" Foreground="White"> </Label>
                    <TextBox x:Name="txtNumeroUno" FontSize="14" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <Label Content="Número 2" FontSize="16" FontWeight="Bold" Foreground="White"></Label>
                    <TextBox x:Name="txtNumeroDos" FontSize="14" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </StackPanel>
                
            </Border>

            <Border Grid.Column="1" Background="#4682B4" CornerRadius="10" Margin ="0,0,10,0" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Operaciones" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="White"/>

                    <Grid Margin="10,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnSuma" Grid.Row="0" Grid.Column="0"
                            Content="+"
                            Width="50"
                            Height="50"
                            Margin="30,0,0,10" Click="btnSuma_Click" Cursor="Hand"/>

                        <Button x:Name="btnResta" Grid.Row="0" Grid.Column="1"
                            Content="-"
                            Width="50"
                            Height="50"
                            Margin="0,0,30,10" Cursor="Hand" Click="btnResta_Click"/>

                        <Button x:Name="btnMultiplicacion" Grid.Row="1" Grid.Column="0"
                            Content="×"
                            Width="50"
                            Height="50"
                            Margin="30,0,0,10" Cursor="Hand" Click="btnMultiplicacion_Click"/>

                        <Button x:Name="btnDivision" Grid.Row="1" Grid.Column="1"
                            Content="/"
                            Width="50"
                            Height="50"
                            Margin="0,0,30,10" Cursor="Hand" Click="btnDivision_Click"/>
            
                    </Grid>
                   
                </StackPanel>
            
            </Border>
            
        </Grid>

        <Border Grid.Row="2" Background="#FFE4C4" Height="80" CornerRadius="15" Margin="0,20,0,0" Padding="17">
            <TextBlock x:Name="lblResultado" Text="Resultado: " HorizontalAlignment="Center" Foreground="#008B8B" FontWeight="Bold" FontSize="25"></TextBlock>
        </Border>

        </Grid>
</Window>
